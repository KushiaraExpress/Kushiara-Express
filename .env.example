# ==============================================================================
# KUSHIARA EXPRESS — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env for local development and set these in Netlify Dashboard
# under Site Settings -> Environment Variables for production.

# Public Supabase Configuration (safe for browser / Vite client bundle)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SITE_URL="https://kushiaraexpress.com"

# Server-Side Only Secrets (NEVER prefix with VITE_ — used only by Netlify Functions & server.ts)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Super Admin Bootstrap (used by server-side verification — ALWAYS use a strong password in production)
SUPER_ADMIN_EMAIL="admin@kushiaraexpress.com"
SUPER_ADMIN_PASSWORD="SET_A_STRONG_UNIQUE_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING"

# Google Search Console Verification Token (optional)
VITE_GOOGLE_SITE_VERIFICATION=""

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
